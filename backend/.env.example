APP_NAME=OptiFleet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=optifleet
DB_USERNAME=optifleet
DB_PASSWORD=optifleet

# --- MongoDB (Phase 6: analytics / data warehouse projection only —
# never the transactional source of truth; see config/database.php) ---
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=optifleet_analytics
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin
# MONGO_URI= # optional full DSN (mongodb+srv://... for Atlas etc.), overrides host/port above

# --- Analytics ETL (Phase 6) ---
ANALYTICS_DEFAULT_TIMEZONE=UTC
ANALYTICS_SCHEDULE_TIME=02:00
ANALYTICS_ETL_MAX_RETRIES=3
ANALYTICS_ETL_TIMEOUT_SECONDS=600
ANALYTICS_INCREMENTAL_LOOKBACK_DAYS=3
ANALYTICS_ETL_LOG_RETENTION_DAYS=180

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=optifleet_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
