APP_NAME=OptiFleet
APP_ENV=local
# Demo data is seeded by `php artisan migrate:fresh --seed` when APP_ENV=local; set to false to skip, never true in production.
#SEED_DEMO_DATA=
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=optifleet
DB_USERNAME=optifleet
DB_PASSWORD=optifleet

# --- MongoDB (Phase 6: analytics / data warehouse projection only —
# never the transactional source of truth; see config/database.php) ---
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=optifleet_analytics
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin
# MONGO_URI= # optional full DSN (mongodb+srv://... for Atlas etc.), overrides host/port above

# --- Analytics ETL (Phase 6) ---
ANALYTICS_DEFAULT_TIMEZONE=UTC
ANALYTICS_SCHEDULE_TIME=02:00
ANALYTICS_ETL_MAX_RETRIES=3
ANALYTICS_ETL_TIMEOUT_SECONDS=600
ANALYTICS_INCREMENTAL_LOOKBACK_DAYS=3
ANALYTICS_ETL_LOG_RETENTION_DAYS=180

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=optifleet_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- OptiNexus platform integration (SSO + API Gateway); off by default ---
OPTINEXUS_ENABLED=false
OPTINEXUS_BASE_URL=
OPTINEXUS_SSO_PROVISION_TENANTS=true
OPTINEXUS_SSO_CLIENT_ID=
OPTINEXUS_SSO_CLIENT_SECRET=
OPTINEXUS_SSO_REDIRECT_URI=
OPTINEXUS_SSO_FRONTEND_URL=
OPTINEXUS_GATEWAY_CLIENT_ID=
OPTINEXUS_GATEWAY_CLIENT_SECRET=
# Report integration outbox events (invoices, memos) to OptiNexus; also needs the event.write scope.
OPTINEXUS_EVENTS_ENABLED=false
# Central governance: existing LOCAL tenants require an operator cutover; new SSO tenants start CENTRAL.
# The service account needs the scopes authorization.check, commercial.read and tenant.delegate and must be bound to this application.
# Freshness of cached OptiNexus answers in seconds (never above 300); on failure access is denied, never granted from a stale answer.
OPTINEXUS_GOVERNANCE_TTL=300
OPTINEXUS_APPLICATION_CODE=optifleet
OPTINEXUS_GOVERNANCE_TIMEOUT=5
OPTINEXUS_GOVERNANCE_CONNECT_TIMEOUT=3
# Accounting feed (docs/integration/ACCOUNTING_FEED.md): with OptiNexus enabled the feed credential is only honoured while the tenant
# is paired in OptiNexus and both products are subscribed (needs the commercial.read scope). "required" enforces it without OPTINEXUS_ENABLED.
OPTINEXUS_FEED_PAIRING=auto
OPTINEXUS_FEED_CONSUMER_APPLICATION=optiaccounting
OPTINEXUS_FEED_CONSUMER_CAPABILITIES=ACCOUNTING_INTEGRATION,OPTIFLEET_CONNECTOR
# Telematics odometer (docs/integration/TELEMATICS_ODOMETER.md): needs the gateway scope gateway.telematics.read. A tenant is synced only
# while OptiNexus says it is subscribed to this application AND the tenant switched the feed on in Fleet. Defaults are physical bounds.
OPTINEXUS_TELEMATICS_APPLICATION=optiradar
OPTINEXUS_TELEMATICS_FUTURE_TOLERANCE=300
OPTINEXUS_TELEMATICS_DECREASE_TOLERANCE_KM=1.00
OPTINEXUS_TELEMATICS_JUMP_SLACK_KM=50
OPTINEXUS_TELEMATICS_JUMP_MAX_KMH=160
OPTINEXUS_TELEMATICS_SYNC_STALE_MINUTES=15
OPTINEXUS_TELEMATICS_READING_STALE_HOURS=24
# A projection that did not land within this many minutes is reported by accounting-feed:monitor (scheduled every 5 minutes).
ACCOUNTING_FEED_MISSED_AFTER_MINUTES=2
