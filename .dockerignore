# Build context is the repository root (see docker-compose.yml), so per-directory
# .dockerignore files (backend/.dockerignore, frontend/.dockerignore) are NOT applied.
# Never bake local secrets, dependencies or runtime data into an image.
.git
**/.env
**/.env.*
!**/.env.example

backend/vendor
backend/node_modules
backend/tests
backend/.phpunit.result.cache
# Runtime data: uploads live in the optifleet_storage volume, never in the image.
backend/storage/app/private/*
backend/storage/app/public/*
backend/storage/logs/*
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/testing/*
backend/storage/framework/views/*
backend/bootstrap/cache/*.php

frontend/node_modules
frontend/dist
