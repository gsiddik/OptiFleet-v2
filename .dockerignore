# Build context is the repository root (see docker-compose.yml), so per-directory .dockerignore files
# (backend/.dockerignore, frontend/.dockerignore) are NOT applied. Nothing from a developer's working copy may reach an image:
# environment files, installed dependencies, caches, logs, uploads, tests, VCS data and documentation.
.git
.github
**/.env
**/.env.*
!**/.env.example
**/node_modules
**/vendor
**/dist
**/coverage
**/*.log
**/.DS_Store
backend/tests
backend/.phpunit.result.cache
backend/.phpunit.cache
# Runtime data: uploads live in the optifleet_storage volume, never in the image.
backend/storage/app
backend/storage/logs
backend/storage/framework
backend/bootstrap/cache
frontend/tests
docs
