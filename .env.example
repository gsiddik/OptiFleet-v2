# OptiFleet container runtime: copy to .env (never commit it). Compose reads this file for ${...} interpolation only; the containers get
# exactly the values passed in docker-compose.yml. After changing a value run `docker compose up -d`; no image rebuild is needed.
# For local development without containers see backend/.env.example and frontend/.env.example.
#
# Required (Compose refuses to start without them):
#   APP_KEY      base64: + 32 random bytes, e.g.  echo "base64:$(openssl rand -base64 32)"
#                (PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); "base64:" + [Convert]::ToBase64String($b))
#   DB_PASSWORD  a long random string (an existing installation keeps the password its database already uses; the former default was optifleet)
APP_KEY=
DB_PASSWORD=

# Origin the browser uses for the console (it also serves /api and /storage). Also the OIDC redirect origin when signing in through OptiNexus.
FLEET_PUBLIC_URL=http://localhost:5173

# Host ports and the address they are published on (127.0.0.1 = this machine only).
BIND_ADDRESS=127.0.0.1
FLEET_API_PORT=8000
FLEET_UI_PORT=5173

# catalog = production-safe system and reference data (permissions, modules, workflow, templates, master data); demo = also the demo layer
# (DevDemoSeeder; never for production); none = skip seeding. The first platform administrator is created afterwards with
# `docker compose exec api php artisan platform:create-admin` (README, "Seed data").
FLEET_SEED=catalog

# --- OptiNexus adapter (only when OPTINEXUS_ENABLED=true; docs/status/OPTINEXUS_INTEGRATION_STATUS.md)
# OPTINEXUS_BASE_URL must be the OIDC issuer exactly as OptiNexus publishes it, reachable from this container and from the browser.
OPTINEXUS_ENABLED=false
OPTINEXUS_BASE_URL=
OPTINEXUS_SSO_CLIENT_ID=
OPTINEXUS_SSO_CLIENT_SECRET=
OPTINEXUS_EVENTS_ENABLED=false
OPTINEXUS_GATEWAY_CLIENT_ID=
OPTINEXUS_GATEWAY_CLIENT_SECRET=

# Optional
APP_ENV=production
APP_DEBUG=false
DB_DATABASE=optifleet
DB_USERNAME=optifleet
MONGO_DATABASE=optifleet_analytics
ANALYTICS_DEFAULT_TIMEZONE=UTC
ANALYTICS_SCHEDULE_TIME=02:00
CLIENT_MAX_BODY_SIZE=20m
