# OptiFleet — Docker Compose environment
# Copy to .env at the repository root: cp .env.example .env
# These values are read by docker-compose.yml for all services.
# For local, non-Docker development, see backend/.env.example and
# frontend/.env.example instead.

# --- Application ---
APP_ENV=local
APP_DEBUG=true
# Generate your own: `php artisan key:generate --show` from inside the backend container.
# This default is fine for local development only — never use it in production.
APP_KEY=base64:0JAG780H7vjmdJRGuOdhLcgd0oumaiSGaNikT1sh8ZY=
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# --- Ports exposed on the host ---
APP_PORT=8000
FRONTEND_PORT=5173
DB_PORT=5432
REDIS_PORT=6379
MONGO_PORT=27017

# --- PostgreSQL ---
DB_DATABASE=optifleet
DB_USERNAME=optifleet
DB_PASSWORD=optifleet

# --- Frontend build-time API base URL ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
